# Copy this file to .env and fill in your own values. Never commit the real .env.

# --- Groq LLM (required for Q&A and Document Insights) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVAL_TOP_K=4

# --- Upload limits ---
MAX_UPLOAD_MB=30

# --- Frontend -> Backend URL ---
# Local (no Docker): http://localhost:8000
# Docker Compose: http://backend:8000  (set automatically in docker-compose.yml)
BACKEND_URL=http://localhost:8000
